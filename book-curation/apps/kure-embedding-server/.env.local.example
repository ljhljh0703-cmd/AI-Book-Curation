# 로컬 PC 실행 전용 kure-embedding-server 설정입니다.
# 목적: ai-server(localhost:8001) → kure-embedding-server(localhost:8002) 호출을 로컬에서 테스트합니다.

APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8002

KURE_MODEL_NAME=nlpai-lab/KURE-v1
KURE_MODEL_PATH=
KURE_MODEL_CACHE_DIR=.local/models
KURE_DEVICE=cpu
KURE_EXPECTED_DIMENSION=1024
KURE_BATCH_SIZE=16
KURE_TORCH_NUM_THREADS=2
KURE_NORMALIZE_EMBEDDINGS=true

# ai-server/.env.local의 KURE_INTERNAL_API_KEY와 반드시 같은 값이어야 합니다.
KURE_INTERNAL_API_KEY=05b595c966eb3a1ace07883264f4af81f8e085e523264f4157ebb104ea08b72f
KURE_INTERNAL_HEADER_NAME=X-KURE-Internal-Key
