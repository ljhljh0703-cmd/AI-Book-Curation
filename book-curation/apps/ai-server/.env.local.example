# 로컬 PC 실행 전용 ai-server 설정 예시입니다.
# 바로 사용하려면 이 파일을 .env.local로 복사하세요.
# 실제 사용 환경변수명 안내:
# - backend → ai-server 인증키: AI_INTERNAL_API_KEY
# - ai-server → kure-embedding-server 인증키: KURE_INTERNAL_API_KEY
# - KURE 서버 주소: KURE_EMBEDDING_BASE_URL

APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8001
CLOVA_API_KEY=
CLOVA_CHAT_URL=https://clovastudio.stream.ntruss.com/v3/chat-completions
CLOVA_EMBED_URL=https://clovastudio.stream.ntruss.com/v1/api-tools/embedding/v2
CLOVA_CHAT_MODEL=HCX-005
CLOVA_EMBED_MODEL=embedding-v2

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=books
QDRANT_KURE_COLLECTION=books_kure
QDRANT_ENSURE_PAYLOAD_INDEXES=false

KURE_EMBEDDING_BASE_URL=http://localhost:8002
KURE_INTERNAL_API_KEY=
KURE_INTERNAL_HEADER_NAME=X-KURE-Internal-Key
KURE_REQUEST_TIMEOUT_SECONDS=10
KURE_FALLBACK_TO_CLOVA=false

QDRANT_CANDIDATE_LIMIT=100
RULE_CANDIDATE_LIMIT=50
PERSONALIZATION_CANDIDATE_LIMIT=20
FINAL_RECOMMEND_COUNT=5
PERSONALIZATION_PROVIDER=PROFILE_VECTOR
SEQUENCE_PROVIDER=NONE
RERANKER_PROVIDER=NONE

# LightFM artifact runtime. 로컬 artifact를 사용할 때만 true로 켜세요.
LIGHTFM_ENABLED=false
LIGHTFM_ARTIFACT_DIR=artifacts/lightfm/current
LIGHTFM_TOP_N=20
LIGHTFM_CANDIDATE_LIMIT=50
LIGHTFM_ITEM_ID_FIELDS=isbn,isbn13,book_id,bookId,itemId
LIGHTFM_NUM_THREADS=2
LIGHTFM_SCORE_MODEL_WEIGHT=0.8
LIGHTFM_SCORE_RULE_WEIGHT=0.2
LIGHTFM_FALLBACK_TO_RULE_BASED=true

# Recommendation response latency controls
RECOMMENDATION_REASON_ASYNC_ENABLED=true
RECOMMENDATION_REASON_ASYNC_WORKERS=2
RECOMMENDATION_REASON_ASYNC_TTL_SECONDS=900
AUDIENCE_LABEL_PROVIDER=PAYLOAD_ONLY
AUDIENCE_LABEL_CANDIDATE_LIMIT=12
AUDIENCE_LABEL_ENABLE_FOR_PROFILE_RERANK=false

AI_INTERNAL_API_KEY=
AI_INTERNAL_HEADER_NAME=X-AI-Internal-Key
AI_REQUEST_RATE_LIMIT_ENABLED=false

# GTE multilingual reranker. Local PC GPU primary(192.168.0.9:7997) → NAS/k3s fallback 순서로 호출합니다.
RERANKER_ENABLED=false
RERANKER_PROVIDER=GTE_MULTILINGUAL
GTE_RERANKER_PRIMARY_URL=http://192.168.0.9:7997/rerank
GTE_RERANKER_FALLBACK_URL=http://gte-reranker-server:8080/rerank
GTE_RERANKER_API_KEY=
GTE_RERANKER_HEADER_NAME=X-GTE-Reranker-Key
GTE_RERANKER_MODEL_NAME=Alibaba-NLP/gte-multilingual-reranker-base
GTE_RERANKER_MAX_DOCUMENTS=20
GTE_RERANKER_MAX_DOC_CHARS=600
GTE_RERANKER_PRIMARY_TIMEOUT_SECONDS=3.0
GTE_RERANKER_FALLBACK_TIMEOUT_SECONDS=8.0
GTE_RERANKER_FAIL_OPEN=true
GTE_RERANKER_RETRY_COUNT=0

# HCX reranker. 관리자에서 HCX_RERANKER를 선택하면 CLOVA Studio Reranker API를 호출합니다.
# HCX_RERANKER_API_KEY가 비어 있으면 CLOVA_API_KEY를 사용합니다.
HCX_RERANKER_URL=https://clovastudio.stream.ntruss.com/v1/api-tools/reranker
HCX_RERANKER_API_KEY=
HCX_RERANKER_MAX_DOCUMENTS=20
HCX_RERANKER_MAX_DOC_CHARS=900
HCX_RERANKER_MAX_TOKENS=1024
HCX_RERANKER_TIMEOUT_SECONDS=12
HCX_RERANK_CACHE_TTL_SECONDS=600


# Valkey/Redis TTL cache / lock settings
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_KEY_PREFIX=book-curation-local
REDIS_SOCKET_TIMEOUT_SECONDS=1.0
GUEST_CHAT_TTL_SECONDS=86400
GUEST_RATE_LIMIT_PER_MINUTE=8
GUEST_RATE_LIMIT_PER_DAY=40
RECOMMENDATION_CACHE_TTL_SECONDS=600
QDRANT_SEARCH_CACHE_TTL_SECONDS=600
GTE_RERANK_CACHE_TTL_SECONDS=600
QDRANT_CACHE_ENABLED=true
QDRANT_SEARCH_TIMEOUT_SECONDS=5.0
QDRANT_SEARCH_LIMIT=80
QDRANT_PREFETCH_LIMIT=100
GTE_RERANK_TOP_K=20
RECOMMENDATION_CANDIDATE_LIMIT=80
