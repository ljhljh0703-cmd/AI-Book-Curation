# Local PC GPU profile for gte-reranker-server.
# 실제 실행 시 이 파일을 .env.local 로 복사해서 사용하세요. .env.local 은 Git에 올리지 않습니다.
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=7997

GTE_RERANKER_MODEL_NAME=Alibaba-NLP/gte-multilingual-reranker-base
GTE_RERANKER_MODEL_PATH=
GTE_RERANKER_MODEL_CACHE_DIR=.local/models
GTE_RERANKER_DEVICE=cuda
GTE_RERANKER_BATCH_SIZE=8
GTE_RERANKER_TORCH_NUM_THREADS=4
GTE_RERANKER_TRUST_REMOTE_CODE=true
GTE_RERANKER_MAX_TEXT_CHARS=1200

# ai-server의 GTE_RERANKER_API_KEY와 같으면 내부 호출만 허용합니다. 비워두면 인증을 사용하지 않습니다.
GTE_RERANKER_API_KEY=
GTE_RERANKER_HEADER_NAME=X-GTE-Reranker-Key
