# Database
DB_HOST=localhost
DB_PORT=15432
DB_NAME=book_curation
DB_USERNAME=book_user
DB_PASSWORD=change-me

# Data4Library
DATA4LIBRARY_AUTH_KEY=change-me

# HCX / NCP
HCX_API_KEY=change-me
HCX_BASE_URL=change-me

# OAuth
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

KAKAO_CLIENT_ID=change-me
KAKAO_CLIENT_SECRET=change-me

# Frontend / Backend
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_ORIGIN=http://localhost:8080

# AI Server / LightFM artifact runtime
LIGHTFM_ENABLED=false
LIGHTFM_ARTIFACT_DIR=apps/ai-server/artifacts/lightfm/current
LIGHTFM_TOP_N=20
LIGHTFM_CANDIDATE_LIMIT=50
LIGHTFM_ITEM_ID_FIELDS=isbn,isbn13,book_id,bookId,itemId
LIGHTFM_NUM_THREADS=2
LIGHTFM_SCORE_MODEL_WEIGHT=0.8
LIGHTFM_SCORE_RULE_WEIGHT=0.2
LIGHTFM_FALLBACK_TO_RULE_BASED=true

# Recommendation response latency controls
RECOMMENDATION_REASON_ASYNC_ENABLED=true
RECOMMENDATION_REASON_ASYNC_WORKERS=2
RECOMMENDATION_REASON_ASYNC_TTL_SECONDS=900
AUDIENCE_LABEL_PROVIDER=PAYLOAD_ONLY
AUDIENCE_LABEL_CANDIDATE_LIMIT=12
AUDIENCE_LABEL_ENABLE_FOR_PROFILE_RERANK=false

# Valkey / Redis-compatible cache, locks and guest temporary state
# 로그인 핵심 데이터는 PostgreSQL에 저장하고, Valkey/Redis는 TTL 캐시/락/비로그인 임시 저장소로 사용합니다.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_KEY_PREFIX=book-curation-local
REDIS_SOCKET_TIMEOUT_SECONDS=1.0
GUEST_CHAT_TTL_SECONDS=86400
GUEST_DUPLICATE_LOCK_TTL_SECONDS=20
GUEST_RATE_LIMIT_PER_MINUTE=8
GUEST_RATE_LIMIT_PER_DAY=40
RECOMMENDATION_CACHE_TTL_SECONDS=600
QDRANT_SEARCH_CACHE_TTL_SECONDS=600
GTE_RERANK_CACHE_TTL_SECONDS=600
ADMIN_JOB_LOCK_TTL_SECONDS=21600
QDRANT_SEARCH_TIMEOUT_SECONDS=5.0
QDRANT_SEARCH_LIMIT=80
QDRANT_PREFETCH_LIMIT=100
QDRANT_CACHE_ENABLED=true
GTE_RERANK_TOP_K=20
RECOMMENDATION_CANDIDATE_LIMIT=80
