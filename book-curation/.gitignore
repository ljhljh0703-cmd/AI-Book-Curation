.gradle/
build/
out/
target/
apps/backend/bin/

# secret/local spring config
application-secret.yml
application-local.yml

# 팀원 공유용 local profile 설정 파일
# 실제 비밀번호가 아니라 ${DB_PASSWORD:...} 같은 환경변수 참조 방식이면 커밋 가능
!apps/backend/src/main/resources/application-local.yml

